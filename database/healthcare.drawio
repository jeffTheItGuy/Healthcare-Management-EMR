        <UserObject label="  PostgreSQL RLS Policies&#xa;  - staff_own_department: staff can only&#xa;    view patients they&#39;ve treated or&#xa;    are assigned to their department&#xa;  - patient_self_access: patients can&#xa;    view their own records via portal&#xa;  - audit_logs capture every access" plantUmlId="note_553" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" plantUmlBaseValue="  PostgreSQL RLS Policies&#xa;  - staff_own_department: staff can only&#xa;    view patients they&#39;ve treated or&#xa;    are assigned to their department&#xa;  - patient_self_access: patients can&#xa;    view their own records via portal&#xa;  - audit_logs capture every access" id="vznR4AJISN_gQ8VAilp--1651">
          <mxCell parent="vznR4AJISN_gQ8VAilp--1099" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1">
