<mxfile host="Electron">
  <diagram name="Page-1" id="A6gWqUQs_rgM0w_2yifa">
    <mxGraphModel dx="1708" dy="493" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho\nskinparam class {\n    BorderThickness 1.5\n    ArrowColor #424242\n    FontColor #212121\n}\n\n&#39; ============================================================\n&#39; ZIMBABWE HOSPITAL EMR — SEMANTIC SEARCH ONLY (NO RAG)\n&#39; Assumes: Lab + Pharmacy + Wards + pgvector for search\n&#39; Uses small local model (e.g. all-MiniLM-L6-v2, 384 dims)\n&#39; No LLM pipeline, no chat history, no RAG context injection\n&#39; ============================================================\n\n&#39; ===== PATIENTS &amp; PRIVACY (Blue) =====\nentity patients #BBDEFB {\n    * patient_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * patient_number : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * national_id : VARCHAR(50)\n    * first_name : VARCHAR(100)\n    * last_name : VARCHAR(100)\n    * date_of_birth : DATE\n    * gender : ENUM(&#39;MALE&#39;,&#39;FEMALE&#39;,&#39;OTHER&#39;)\n    * blood_group : VARCHAR(5)\n    * phone_primary : VARCHAR(20)\n    * phone_secondary : VARCHAR(20)\n    * email : VARCHAR(255)\n    * address : TEXT\n    * city : VARCHAR(100)\n    * suburb : VARCHAR(100)\n    * emergency_contact_name : VARCHAR(200)\n    * emergency_contact_phone : VARCHAR(20)\n    * medical_aid_provider_id : UUID &lt;&lt;FK&gt;&gt;\n    * medical_aid_number : VARCHAR(50)\n    * medical_aid_plan : VARCHAR(50)\n    * allergies : TEXT\n    * chronic_conditions : TEXT\n    * is_active : BOOLEAN &lt;&lt;DF TRUE&gt;&gt;\n    * deleted_at : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n    * updated_at : TIMESTAMPTZ\n    --\n    &lt;&lt;RLS&gt;&gt; ENABLE ROW LEVEL SECURITY\n    &lt;&lt;RLS&gt;&gt; POLICY: staff_own_department\n    &lt;&lt;RLS&gt;&gt; POLICY: patient_self_access\n}\n\nentity patient_consents #BBDEFB {\n    * consent_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * consent_type : ENUM(&#39;TREATMENT&#39;,&#39;DATA_SHARING&#39;,&#39;RESEARCH&#39;,&#39;MARKETING&#39;)\n    * consent_given : BOOLEAN\n    * consent_document : VARCHAR(500)\n    * valid_from : DATE\n    * valid_until : DATE\n    * revoked_at : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n}\n\nentity patient_access_logs #BBDEFB {\n    * access_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * accessed_by_staff_id : UUID &lt;&lt;FK&gt;&gt;\n    * access_reason : VARCHAR(255)\n    * access_type : ENUM(&#39;VIEW&#39;,&#39;CREATE&#39;,&#39;UPDATE&#39;,&#39;DELETE&#39;,&#39;EXPORT&#39;)\n    * ip_address : INET\n    * accessed_at : TIMESTAMPTZ\n}\n\n&#39; ===== MEDICAL AID (Cyan) =====\nentity medical_aid_providers #B2EBF2 {\n    * provider_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * provider_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * provider_name : VARCHAR(200)\n    * contact_phone : VARCHAR(20)\n    * contact_email : VARCHAR(255)\n    * claim_submission_url : VARCHAR(500)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== STAFF &amp; ROSTERS (Purple) =====\nentity departments #E1BEE7 {\n    * department_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * department_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * department_name : VARCHAR(100)\n    * department_type : ENUM(&#39;OPD&#39;,&#39;IPD&#39;,&#39;LABORATORY&#39;,&#39;PHARMACY&#39;,&#39;RADIOLOGY&#39;,&#39;ADMIN&#39;,&#39;FINANCE&#39;,&#39;THEATRE&#39;)\n    * location : VARCHAR(100)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\nentity staff #E1BEE7 {\n    * staff_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * staff_number : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * national_id : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * first_name : VARCHAR(100)\n    * last_name : VARCHAR(100)\n    * role : ENUM(&#39;DOCTOR&#39;,&#39;NURSE&#39;,&#39;LAB_TECH&#39;,&#39;PHARMACIST&#39;,&#39;RADIOLOGIST&#39;,&#39;ADMIN&#39;,&#39;CASHIER&#39;,&#39;MANAGER&#39;)\n    * department_id : UUID &lt;&lt;FK&gt;&gt;\n    * specialization : VARCHAR(100)\n    * license_number : VARCHAR(50)\n    * phone : VARCHAR(20)\n    * email : VARCHAR(255)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\nentity staff_credentials #E1BEE7 {\n    * credential_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * staff_id : UUID &lt;&lt;FK&gt;&gt;\n    * username : VARCHAR(100) &lt;&lt;UQ&gt;&gt;\n    * password_hash : VARCHAR(255)\n    * mfa_enabled : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * last_login_at : TIMESTAMPTZ\n    * password_changed_at : TIMESTAMPTZ\n    * failed_login_attempts : INT &lt;&lt;DF 0&gt;&gt;\n    * locked_until : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n}\n\nentity staff_rosters #E1BEE7 {\n    * roster_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * staff_id : UUID &lt;&lt;FK&gt;&gt;\n    * department_id : UUID &lt;&lt;FK&gt;&gt;\n    * roster_date : DATE\n    * shift_type : ENUM(&#39;MORNING&#39;,&#39;AFTERNOON&#39;,&#39;NIGHT&#39;,&#39;ON_CALL&#39;,&#39;OFF&#39;)\n    * start_time : TIME\n    * end_time : TIME\n    * ward_id : UUID &lt;&lt;FK&gt;&gt;\n    * notes : TEXT\n    * created_by : UUID\n    * created_at : TIMESTAMPTZ\n    --\n    &lt;&lt;UQ&gt;&gt; (staff_id, roster_date, shift_type)\n}\n\n&#39; ===== WARDS &amp; BEDS (Indigo) =====\nentity wards #C5CAE9 {\n    * ward_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * ward_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * ward_name : VARCHAR(100)\n    * department_id : UUID &lt;&lt;FK&gt;&gt;\n    * ward_type : ENUM(&#39;GENERAL&#39;,&#39;PRIVATE&#39;,&#39;ICU&#39;,&#39;MATERNITY&#39;,&#39;PAEDIATRIC&#39;,&#39;ISOLATION&#39;)\n    * floor_level : INT\n    * capacity : INT\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\nentity beds #C5CAE9 {\n    * bed_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * ward_id : UUID &lt;&lt;FK&gt;&gt;\n    * bed_number : VARCHAR(20)\n    * bed_type : ENUM(&#39;STANDARD&#39;,&#39;ELECTRIC&#39;,&#39;BASSINET&#39;,&#39;ISOLATION&#39;)\n    * status : ENUM(&#39;AVAILABLE&#39;,&#39;OCCUPIED&#39;,&#39;MAINTENANCE&#39;,&#39;RESERVED&#39;)\n    * current_admission_id : UUID\n    * created_at : TIMESTAMPTZ\n    --\n    &lt;&lt;UQ&gt;&gt; (ward_id, bed_number)\n}\n\n&#39; ===== APPOINTMENTS (Green) =====\nentity appointments #C8E6C9 {\n    * appointment_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * appointment_number : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * doctor_id : UUID &lt;&lt;FK&gt;&gt;\n    * department_id : UUID &lt;&lt;FK&gt;&gt;\n    * appointment_type : ENUM(&#39;OPD_CONSULTATION&#39;,&#39;FOLLOW_UP&#39;,&#39;LAB_REVIEW&#39;,&#39;PROCEDURE&#39;,&#39;TELEMEDICINE&#39;)\n    * scheduled_date : DATE\n    * scheduled_time : TIME\n    * estimated_duration_minutes : INT\n    * status : ENUM(&#39;SCHEDULED&#39;,&#39;CHECKED_IN&#39;,&#39;IN_PROGRESS&#39;,&#39;COMPLETED&#39;,&#39;NO_SHOW&#39;,&#39;CANCELLED&#39;)\n    * chief_complaint : TEXT\n    * notes : TEXT\n    * checked_in_at : TIMESTAMPTZ\n    * completed_at : TIMESTAMPTZ\n    * created_by : UUID\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== MEDICAL RECORDS (Red) =====\nentity medical_records #FFCDD2 {\n    * record_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * appointment_id : UUID &lt;&lt;FK&gt;&gt;\n    * admission_id : UUID &lt;&lt;FK&gt;&gt;\n    * encounter_type : ENUM(&#39;OPD&#39;,&#39;IPD&#39;,&#39;EMERGENCY&#39;,&#39;TELEMEDICINE&#39;)\n    * attending_doctor_id : UUID &lt;&lt;FK&gt;&gt;\n    * nurse_id : UUID &lt;&lt;FK&gt;&gt;\n    * encounter_date : TIMESTAMPTZ\n    * chief_complaint : TEXT\n    * history_of_present_illness : TEXT\n    * physical_examination : TEXT\n    * vital_signs : JSONB\n    * assessment_and_plan : TEXT\n    * discharge_notes : TEXT\n    * follow_up_instructions : TEXT\n    * is_locked : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * locked_by : UUID\n    * locked_at : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n    --\n    &lt;&lt;RLS&gt;&gt; ENABLE ROW LEVEL SECURITY\n}\n\nentity diagnoses #FFCDD2 {\n    * diagnosis_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * record_id : UUID &lt;&lt;FK&gt;&gt;\n    * icd10_code : VARCHAR(10)\n    * diagnosis_name : VARCHAR(255)\n    * diagnosis_type : ENUM(&#39;PRIMARY&#39;,&#39;SECONDARY&#39;,&#39;DIFFERENTIAL&#39;)\n    * notes : TEXT\n    * diagnosed_by : UUID &lt;&lt;FK&gt;&gt;\n    * created_at : TIMESTAMPTZ\n}\n\nentity prescriptions #FFCDD2 {\n    * prescription_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * record_id : UUID &lt;&lt;FK&gt;&gt;\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * prescribed_by : UUID &lt;&lt;FK&gt;&gt;\n    * prescription_date : TIMESTAMPTZ\n    * status : ENUM(&#39;PENDING&#39;,&#39;DISPENSED&#39;,&#39;PARTIAL&#39;,&#39;CANCELLED&#39;)\n    * pharmacy_notes : TEXT\n    * created_at : TIMESTAMPTZ\n}\n\nentity prescription_items #FFCDD2 {\n    * item_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * prescription_id : UUID &lt;&lt;FK&gt;&gt;\n    * medication_id : UUID &lt;&lt;FK&gt;&gt;\n    * dosage : VARCHAR(100)\n    * frequency : VARCHAR(100)\n    * duration_days : INT\n    * quantity_prescribed : DECIMAL(10,2)\n    * quantity_dispensed : DECIMAL(10,2)\n    * instructions : TEXT\n    * is_substitutable : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== ADMISSIONS (Orange) =====\nentity admissions #FFE0B2 {\n    * admission_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * bed_id : UUID &lt;&lt;FK&gt;&gt;\n    * admitting_doctor_id : UUID &lt;&lt;FK&gt;&gt;\n    * admission_number : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * admission_type : ENUM(&#39;ELECTIVE&#39;,&#39;EMERGENCY&#39;,&#39;REFERRAL&#39;)\n    * admission_date : TIMESTAMPTZ\n    * discharge_date : TIMESTAMPTZ\n    * discharge_type : ENUM(&#39;HOME&#39;,&#39;TRANSFER&#39;,&#39;DEATH&#39;,&#39;ABSCONDED&#39;)\n    * discharge_summary : TEXT\n    * status : ENUM(&#39;ADMITTED&#39;,&#39;DISCHARGED&#39;,&#39;TRANSFERRED&#39;)\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== LABORATORY (Teal) =====\nentity lab_test_catalog #B2DFDB {\n    * test_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * test_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * test_name : VARCHAR(255)\n    * category : VARCHAR(100)\n    * description : TEXT\n    * sample_type : VARCHAR(50)\n    * turnaround_hours : INT\n    * normal_range : TEXT\n    * unit_of_measure : VARCHAR(20)\n    * base_price : DECIMAL(18,2)\n    * currency_code : CHAR(3)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\nentity lab_orders #B2DFDB {\n    * order_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * order_number : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * record_id : UUID &lt;&lt;FK&gt;&gt;\n    * ordered_by : UUID &lt;&lt;FK&gt;&gt;\n    * order_date : TIMESTAMPTZ\n    * priority : ENUM(&#39;ROUTINE&#39;,&#39;URGENT&#39;,&#39;STAT&#39;)\n    * status : ENUM(&#39;ORDERED&#39;,&#39;SAMPLE_COLLECTED&#39;,&#39;IN_PROGRESS&#39;,&#39;COMPLETED&#39;,&#39;CANCELLED&#39;)\n    * clinical_notes : TEXT\n    * created_at : TIMESTAMPTZ\n}\n\nentity lab_order_items #B2DFDB {\n    * order_item_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * order_id : UUID &lt;&lt;FK&gt;&gt;\n    * test_id : UUID &lt;&lt;FK&gt;&gt;\n    * status : ENUM(&#39;PENDING&#39;,&#39;IN_PROGRESS&#39;,&#39;COMPLETED&#39;,&#39;CANCELLED&#39;)\n    * completed_at : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n}\n\nentity lab_results #B2DFDB {\n    * result_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * order_item_id : UUID &lt;&lt;FK&gt;&gt;\n    * test_id : UUID &lt;&lt;FK&gt;&gt;\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * result_value : VARCHAR(255)\n    * result_numeric : DECIMAL(18,6)\n    * unit_of_measure : VARCHAR(20)\n    * reference_range : TEXT\n    * interpretation : ENUM(&#39;NORMAL&#39;,&#39;ABNORMAL&#39;,&#39;CRITICAL&#39;,&#39;BORDERLINE&#39;)\n    * verified_by : UUID &lt;&lt;FK&gt;&gt;\n    * verified_at : TIMESTAMPTZ\n    * result_notes : TEXT\n    * is_critical : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * critical_notified_at : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== PHARMACY (Green) =====\nentity medications #C8E6C9 {\n    * medication_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * generic_name : VARCHAR(255)\n    * brand_name : VARCHAR(255)\n    * dosage_form : ENUM(&#39;TABLET&#39;,&#39;CAPSULE&#39;,&#39;SYRUP&#39;,&#39;INJECTION&#39;,&#39;CREAM&#39;,&#39;DROPS&#39;,&#39;INHALER&#39;,&#39;SUPPOSITORY&#39;)\n    * strength : VARCHAR(50)\n    * atc_code : VARCHAR(10)\n    * category : VARCHAR(100)\n    * reorder_level : INT\n    * reorder_quantity : INT\n    * is_controlled : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * schedule : VARCHAR(20)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\nentity pharmacy_inventory #C8E6C9 {\n    * inventory_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * medication_id : UUID &lt;&lt;FK&gt;&gt;\n    * total_quantity : INT &lt;&lt;DF 0&gt;&gt;\n    * available_quantity : INT &lt;&lt;DF 0&gt;&gt;\n    * reserved_quantity : INT &lt;&lt;DF 0&gt;&gt;\n    * unit_cost_average : DECIMAL(18,4)\n    * currency_code : CHAR(3)\n    * location_rack : VARCHAR(50)\n    * is_active : BOOLEAN\n    * updated_at : TIMESTAMPTZ\n}\n\nentity pharmacy_batches #C8E6C9 {\n    * batch_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * inventory_id : UUID &lt;&lt;FK&gt;&gt;\n    * medication_id : UUID &lt;&lt;FK&gt;&gt;\n    * batch_number : VARCHAR(50)\n    * supplier_id : UUID &lt;&lt;FK&gt;&gt;\n    * quantity_received : INT\n    * quantity_remaining : INT\n    * unit_cost : DECIMAL(18,4)\n    * currency_code : CHAR(3)\n    * expiry_date : DATE\n    * manufacturing_date : DATE\n    * received_date : DATE\n    * grn_reference : VARCHAR(50)\n    * status : ENUM(&#39;ACTIVE&#39;,&#39;EXPIRED&#39;,&#39;DEPLETED&#39;,&#39;QUARANTINE&#39;)\n    * created_at : TIMESTAMPTZ\n    --\n    &lt;&lt;UQ&gt;&gt; (medication_id, batch_number)\n}\n\nentity dispensed_medications #C8E6C9 {\n    * dispense_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * prescription_item_id : UUID &lt;&lt;FK&gt;&gt;\n    * batch_id : UUID &lt;&lt;FK&gt;&gt;\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * dispensed_by : UUID &lt;&lt;FK&gt;&gt;\n    * quantity_dispensed : INT\n    * unit_price : DECIMAL(18,4)\n    * currency_code : CHAR(3)\n    * total_amount : DECIMAL(18,2)\n    * dispense_date : TIMESTAMPTZ\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== SUPPLIERS (Amber) =====\nentity suppliers #FFF8E1 {\n    * supplier_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * supplier_code : VARCHAR(20) &lt;&lt;UQ&gt;&gt;\n    * supplier_name : VARCHAR(200)\n    * contact_person : VARCHAR(100)\n    * phone : VARCHAR(20)\n    * email : VARCHAR(255)\n    * address : TEXT\n    * license_number : VARCHAR(50)\n    * is_active : BOOLEAN\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== BILLING (Yellow) =====\nentity billing_invoices #FFF9C4 {\n    * invoice_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * invoice_number : VARCHAR(50) &lt;&lt;UQ&gt;&gt;\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * record_id : UUID &lt;&lt;FK&gt;&gt;\n    * admission_id : UUID &lt;&lt;FK&gt;&gt;\n    * invoice_type : ENUM(&#39;OPD&#39;,&#39;IPD&#39;,&#39;PHARMACY&#39;,&#39;LABORATORY&#39;,&#39;PACKAGE&#39;,&#39;MIXED&#39;)\n    * currency_code : CHAR(3)\n    * exchange_rate : DECIMAL(24,10)\n    * subtotal : DECIMAL(18,2)\n    * discount_amount : DECIMAL(18,2)\n    * tax_amount : DECIMAL(18,2)\n    * total_amount : DECIMAL(18,2)\n    * base_currency_total : DECIMAL(18,2)\n    * amount_paid : DECIMAL(18,2)\n    * balance_due : DECIMAL(18,2)\n    * payment_status : ENUM(&#39;UNPAID&#39;,&#39;PARTIAL&#39;,&#39;PAID&#39;,&#39;OVERPAID&#39;,&#39;WRITTEN_OFF&#39;)\n    * medical_aid_claimed : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * medical_aid_claim_amount : DECIMAL(18,2)\n    * medical_aid_claim_reference : VARCHAR(50)\n    * invoice_date : TIMESTAMPTZ\n    * due_date : DATE\n    * created_by : UUID\n    * created_at : TIMESTAMPTZ\n}\n\nentity invoice_items #FFF9C4 {\n    * item_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * invoice_id : UUID &lt;&lt;FK&gt;&gt;\n    * item_type : ENUM(&#39;CONSULTATION&#39;,&#39;PROCEDURE&#39;,&#39;MEDICATION&#39;,&#39;LAB_TEST&#39;,&#39;WARD_CHARGE&#39;,&#39;THEATRE&#39;,&#39;SUPPLY&#39;,&#39;PACKAGE&#39;)\n    * reference_id : UUID\n    * description : TEXT\n    * quantity : DECIMAL(10,2)\n    * unit_price : DECIMAL(18,4)\n    * currency_code : CHAR(3)\n    * line_total : DECIMAL(18,2)\n    * base_currency_line_total : DECIMAL(18,2)\n    * created_at : TIMESTAMPTZ\n}\n\nentity payments #FFF9C4 {\n    * payment_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * invoice_id : UUID &lt;&lt;FK&gt;&gt;\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * payment_method : ENUM(&#39;CASH&#39;,&#39;ECOCASH&#39;,&#39;ZIPIT&#39;,&#39;BANK_TRANSFER&#39;,&#39;CARD&#39;,&#39;USD_CASH&#39;,&#39;ZiG_CASH&#39;,&#39;MEDICAL_AID&#39;)\n    * currency_code : CHAR(3)\n    * amount : DECIMAL(18,2)\n    * exchange_rate : DECIMAL(24,10)\n    * base_currency_amount : DECIMAL(18,2)\n    * reference_number : VARCHAR(100)\n    * received_by : UUID\n    * payment_date : TIMESTAMPTZ\n    * reconciled : BOOLEAN &lt;&lt;DF FALSE&gt;&gt;\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== AUDIT (Gray) =====\nentity audit_logs #F5F5F5 {\n    * log_id : BIGSERIAL &lt;&lt;PK&gt;&gt;\n    --\n    * user_id : UUID\n    * staff_id : UUID\n    * action : VARCHAR(100)\n    * entity_type : VARCHAR(50)\n    * entity_id : UUID\n    * old_values : JSONB\n    * new_values : JSONB\n    * ip_address : INET\n    * user_agent : TEXT\n    * session_id : VARCHAR(255)\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== PGVECTOR: SEMANTIC SEARCH ONLY (Deep Purple) =====\nentity clinical_document_sources #B39DDB {\n    * source_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * source_title : VARCHAR(500)\n    * source_type : ENUM(&#39;GUIDELINE&#39;,&#39;PROTOCOL&#39;,&#39;RESEARCH_PAPER&#39;,&#39;DRUG_REFERENCE&#39;,&#39;SOP&#39;,&#39;TEXTBOOK&#39;)\n    * document_url : VARCHAR(1000)\n    * file_hash : VARCHAR(64)\n    * page_count : INT\n    * language : VARCHAR(10) &lt;&lt;DF &#39;en&#39;&gt;&gt;\n    * specialty_tags : TEXT[]\n    * ingest_status : ENUM(&#39;PENDING&#39;,&#39;PROCESSING&#39;,&#39;COMPLETED&#39;,&#39;FAILED&#39;)\n    * is_active : BOOLEAN &lt;&lt;DF TRUE&gt;&gt;\n    * ingested_by : UUID &lt;&lt;FK&gt;&gt;\n    * ingested_at : TIMESTAMPTZ\n    * updated_at : TIMESTAMPTZ\n}\n\nentity clinical_document_chunks #B39DDB {\n    * chunk_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * source_id : UUID &lt;&lt;FK&gt;&gt;\n    * chunk_index : INT\n    * chunk_text : TEXT\n    * chunk_text_embedding : VECTOR(384)\n    * chunk_metadata : JSONB\n    * token_count : INT\n    * created_at : TIMESTAMPTZ\n    --\n    &lt;&lt;IDX&gt;&gt; HNSW(chunk_text_embedding) vector_cosine_ops\n}\n\nentity patient_clinical_embeddings #B39DDB {\n    * embedding_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * patient_id : UUID &lt;&lt;FK&gt;&gt;\n    * record_id : UUID &lt;&lt;FK&gt;&gt;\n    * embedding_type : ENUM(&#39;RECORD_SUMMARY&#39;,&#39;CHIEF_COMPLAINT&#39;,&#39;DIAGNOSIS_HISTORY&#39;,&#39;FULL_HISTORY&#39;)\n    * embedding_text : TEXT\n    * embedding_vector : VECTOR(384)\n    * model_name : VARCHAR(50)\n    * model_version : VARCHAR(20)\n    * generated_at : TIMESTAMPTZ\n    --\n    &lt;&lt;IDX&gt;&gt; HNSW(embedding_vector) vector_cosine_ops\n    &lt;&lt;UQ&gt;&gt; (patient_id, record_id, embedding_type)\n}\n\nentity search_queries #B39DDB {\n    * query_id : UUID &lt;&lt;PK&gt;&gt;\n    --\n    * queried_by_staff_id : UUID &lt;&lt;FK&gt;&gt;\n    * query_text : TEXT\n    * query_embedding : VECTOR(384)\n    * search_target : ENUM(&#39;PATIENTS&#39;,&#39;DOCUMENTS&#39;,&#39;ALL&#39;)\n    * filters : JSONB\n    * top_k : INT &lt;&lt;DF 10&gt;&gt;\n    * similarity_threshold : DECIMAL(3,2) &lt;&lt;DF 0.70&gt;&gt;\n    * results : JSONB\n    * result_count : INT\n    * execution_time_ms : INT\n    * created_at : TIMESTAMPTZ\n}\n\n&#39; ===== RELATIONSHIPS =====\npatients ||--o{ patient_consents\npatients ||--o{ patient_access_logs\npatients ||--o{ appointments\npatients ||--o{ medical_records\npatients ||--o{ prescriptions\npatients ||--o{ admissions\npatients ||--o{ lab_orders\npatients ||--o{ lab_results\npatients ||--o{ dispensed_medications\npatients ||--o{ billing_invoices\npatients ||--o{ payments\npatients ||--o{ patient_clinical_embeddings\n\nmedical_aid_providers ||--o{ patients : covers\n\ndepartments ||--o{ staff\ndepartments ||--o{ wards\ndepartments ||--o{ appointments\ndepartments ||--o{ staff_rosters\n\nstaff ||--o{ staff_credentials\nstaff ||--o{ staff_rosters\nstaff ||--o{ appointments : attends\nstaff ||--o{ medical_records : attends\nstaff ||--o{ diagnoses : makes\nstaff ||--o{ prescriptions : writes\nstaff ||--o{ lab_orders : orders\nstaff ||--o{ lab_results : verifies\nstaff ||--o{ dispensed_medications : dispenses\nstaff ||--o{ admissions : admits\nstaff ||--o{ patient_access_logs : accesses\nstaff ||--o{ billing_invoices : creates\nstaff ||--o{ payments : receives\nstaff ||--o{ search_queries\nstaff ||--o{ clinical_document_sources : ingests\n\nwards ||--o{ beds\nwards ||--o{ staff_rosters : assigned\n\nbeds ||--o{ admissions : occupied_by\n\nappointments ||--o| medical_records : generates\n\nmedical_records ||--o{ diagnoses\nmedical_records ||--o{ prescriptions\nmedical_records ||--o{ lab_orders\nmedical_records ||--o| admissions : triggers\nmedical_records ||--o{ billing_invoices\nmedical_records ||--o{ patient_clinical_embeddings\n\nadmissions ||--o{ medical_records : during\nadmissions ||--o{ billing_invoices\n\nprescriptions ||--o{ prescription_items\nprescriptions ||--o{ dispensed_medications\n\nmedications ||--o{ pharmacy_inventory\nmedications ||--o{ pharmacy_batches\nmedications ||--o{ prescription_items\n\npharmacy_inventory ||--o{ pharmacy_batches\n\nsuppliers ||--o{ pharmacy_batches : supplies\n\nlab_test_catalog ||--o{ lab_order_items\nlab_test_catalog ||--o{ lab_results\n\nlab_orders ||--o{ lab_order_items\nlab_order_items ||--o| lab_results : produces\n\nbilling_invoices ||--o{ invoice_items\nbilling_invoices ||--o{ payments\n\nclinical_document_sources ||--o{ clinical_document_chunks\n\n&#39; ===== ANNOTATIONS =====\nnote right of patients\n  **PostgreSQL RLS Policies**\n  - staff_own_department: staff can only\n    view patients they&#39;ve treated or\n    are assigned to their department\n  - patient_self_access: patients can\n    view their own records via portal\n  - audit_logs capture every access\nend note\n\nnote right of pharmacy_batches\n  **Batch &amp; Expiry Tracking**\n  - FIFO consumption enforced at dispense\n  - EXPIRED status auto-set via cron\n  - QUARANTINE for damaged/recalled stock\n  - Critical in Zim: supply chain disruptions\n    cause variable expiry dates per batch\nend note\n\nnote right of billing_invoices\n  **Multi-Currency Billing (USD/ZiG)**\n  - invoice in service currency\n  - base_currency_total for reporting\n  - Medical aid claims tracked separately\n  - Supports cash, Ecocash, Zipit, bank\n  - exchange_rate locked at invoice time\nend note\n\nnote right of lab_results\n  **Critical Result Alerting**\n  - is_critical flag triggers immediate\n    notification to attending doctor\n  - critical_notified_at tracks response\n  - Interpretation guides treatment urgency\nend note\n\nnote bottom of clinical_document_chunks\n  **pgvector: Semantic Document Search**\n  --\n  Upload MoHCC guidelines, WHO protocols,\n  local SOPs. Chunk + embed with a small\n  local model (all-MiniLM-L6-v2, 384 dims).\n  No API calls, runs entirely on CPU.\n  --\n  **SQL:**\n  SELECT chunk_text,\n    1 - (chunk_text_embedding &lt;=&gt; query_vec) AS similarity\n  FROM clinical_document_chunks\n  ORDER BY chunk_text_embedding &lt;=&gt; query_vec\n  LIMIT 5;\nend note\n\nnote bottom of patient_clinical_embeddings\n  **pgvector: Patient Similarity Search**\n  --\n  - \&quot;Find patients with similar symptoms\&quot;\n  - Embeddings from: chief_complaint + HPI + diagnoses\n  - Cosine similarity ranks patient cohorts\n  - Powers differential diagnosis support\n  --\n  **Privacy:** Same RLS as source records.\n  Embeddings are PHI — treat as medical data.\nend note\n\nnote bottom of search_queries\n  **Search Audit Trail**\n  --\n  Log every semantic search for audit.\n  query_embedding stored for pattern analysis.\n  Helps identify knowledge gaps in\n  your guideline library over time.\nend note\n\nnote bottom of medications\n  **Recommended PostgreSQL Indexes**\n  - patients(patient_number, national_id)\n  - appointments(patient_id, scheduled_date, status)\n  - appointments(doctor_id, scheduled_date)\n  - medical_records(patient_id, encounter_date)\n  - prescriptions(patient_id, status)\n  - pharmacy_batches(medication_id, status, expiry_date)\n  - pharmacy_batches(expiry_date, status) WHERE status=&#39;ACTIVE&#39;\n  - dispensed_medications(patient_id, dispense_date)\n  - lab_orders(patient_id, status, order_date)\n  - lab_results(patient_id, test_id, created_at)\n  - billing_invoices(patient_id, payment_status, invoice_date)\n  - billing_invoices(invoice_number)\n  - invoice_items(invoice_id, item_type)\n  - payments(invoice_id, payment_date)\n  - staff_rosters(staff_id, roster_date)\n  - admissions(patient_id, status, admission_date)\n  --\n  **pgvector Indexes:**\n  - CREATE INDEX ON clinical_document_chunks\n    USING hnsw (chunk_text_embedding vector_cosine_ops)\n    WITH (m = 16, ef_construction = 64);\n  - CREATE INDEX ON patient_clinical_embeddings\n    USING hnsw (embedding_vector vector_cosine_ops);\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="vznR4AJISN_gQ8VAilp--1099">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
