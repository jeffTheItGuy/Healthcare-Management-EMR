' ===== PGVECTOR: SEMANTIC SEARCH & RAG (Deep Purple) =====
entity clinical_document_sources #B39DDB {
    * source_id : UUID <<PK>>
    --
    * source_title : VARCHAR(500)
    * source_type : ENUM('GUIDELINE','PROTOCOL','RESEARCH_PAPER','DRUG_REFERENCE','SOP','TEXTBOOK')
    * document_url : VARCHAR(1000)
    * file_hash : VARCHAR(64)
    * page_count : INT
    * language : VARCHAR(10) <<DF 'en'>>
    * specialty_tags : TEXT[]
    * ingest_status : ENUM('PENDING','PROCESSING','COMPLETED','FAILED')
    * is_active : BOOLEAN <<DF TRUE>>
    * ingested_by : UUID <<FK>>
    * ingested_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
}

entity clinical_document_chunks #B39DDB {
    * chunk_id : UUID <<PK>>
    --
    * source_id : UUID <<FK>>
    * chunk_index : INT
    * chunk_text : TEXT
    * chunk_text_embedding : VECTOR(1536)
    * chunk_metadata : JSONB
    * token_count : INT
    * created_at : TIMESTAMPTZ
    --
    <<IDX>> HNSW(chunk_text_embedding) vector_cosine_ops
}

entity patient_clinical_embeddings #B39DDB {
    * embedding_id : UUID <<PK>>
    --
    * patient_id : UUID <<FK>>
    * record_id : UUID <<FK>>
    * embedding_type : ENUM('RECORD_SUMMARY','CHIEF_COMPLAINT','DIAGNOSIS_HISTORY','FULL_HISTORY')
    * embedding_text : TEXT
    * embedding_vector : VECTOR(1536)
    * model_name : VARCHAR(50)
    * model_version : VARCHAR(20)
    * generated_at : TIMESTAMPTZ
    --
    <<IDX>> HNSW(embedding_vector) vector_cosine_ops
    <<UQ>> (patient_id, record_id, embedding_type)
}

entity semantic_search_queries #B39DDB {
    * query_id : UUID <<PK>>
    --
    * queried_by_staff_id : UUID <<FK>>
