' ============================================================
' ZIMBABWE HOSPITAL EMR — FULL SCHEMA
' Assumes: Lab + Pharmacy + Wards + pgvector RAG
' Core: PostgreSQL 15+ with pgvector extension
' ============================================================

' ===== PATIENTS & PRIVACY (Blue) =====
entity patients #BBDEFB {
    * patient_id : UUID <<PK>>
    --
    * patient_number : VARCHAR(20) <<UQ>>
    * national_id : VARCHAR(50)
    * first_name : VARCHAR(100)
    * last_name : VARCHAR(100)
    * date_of_birth : DATE
    * gender : ENUM('MALE','FEMALE','OTHER')
    * blood_group : VARCHAR(5)
    * phone_primary : VARCHAR(20)
    * phone_secondary : VARCHAR(20)
    * email : VARCHAR(255)
    * address : TEXT
    * city : VARCHAR(100)
    * suburb : VARCHAR(100)
    * emergency_contact_name : VARCHAR(200)
    * emergency_contact_phone : VARCHAR(20)
    * medical_aid_provider_id : UUID <<FK>>
    * medical_aid_number : VARCHAR(50)
    * medical_aid_plan : VARCHAR(50)
    * allergies : TEXT
    * chronic_conditions : TEXT
    * is_active : BOOLEAN <<DF TRUE>>
    * deleted_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
    * updated_at : TIMESTAMPTZ
    --
    <<RLS>> ENABLE ROW LEVEL SECURITY
    <<RLS>> POLICY: staff_own_department
    <<RLS>> POLICY: patient_self_access
}

entity patient_consents #BBDEFB {
    * consent_id : UUID <<PK>>
    --
    * patient_id : UUID <<FK>>
    * consent_type : ENUM('TREATMENT','DATA_SHARING','RESEARCH','MARKETING')
    * consent_given : BOOLEAN
    * consent_document : VARCHAR(500)
    * valid_from : DATE
    * valid_until : DATE
    * revoked_at : TIMESTAMPTZ
    * created_at : TIMESTAMPTZ
}

entity patient_access_logs #BBDEFB {
    * access_id : UUID <<PK>>
    --
    * patient_id : UUID <<FK>>
    * accessed_by_staff_id : UUID <<FK>>
    * access_reason : VARCHAR(255)
    * access_type : ENUM('VIEW','CREATE','UPDATE','DELETE','EXPORT')
    * ip_address : INET
    * accessed_at : TIMESTAMPTZ
}

