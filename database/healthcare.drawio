        <UserObject label="  Multi-Currency Billing (USD/ZiG)&#xa;  - invoice in service currency&#xa;  - base_currency_total for reporting&#xa;  - Medical aid claims tracked separately&#xa;  - Supports cash, Ecocash, Zipit, bank&#xa;  - exchange_rate locked at invoice time" plantUmlId="note_557" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" plantUmlBaseValue="  Multi-Currency Billing (USD/ZiG)&#xa;  - invoice in service currency&#xa;  - base_currency_total for reporting&#xa;  - Medical aid claims tracked separately&#xa;  - Supports cash, Ecocash, Zipit, bank&#xa;  - exchange_rate locked at invoice time" id="vznR4AJISN_gQ8VAilp--1655">
