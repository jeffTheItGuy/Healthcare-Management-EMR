        <UserObject label="  pgvector: Patient Similarity Search&#xa;  --&#xa;  - &quot;Find patients with similar symptoms&quot;&#xa;  - Embeddings from: chief_complaint + HPI + diagnoses&#xa;  - Cosine similarity ranks patient cohorts&#xa;  - Powers differential diagnosis support&#xa;  --&#xa;  Privacy: Same RLS as source records.&#xa;  Embeddings are PHI — treat as medical data." plantUmlId="note_563" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" plantUmlBaseValue="  pgvector: Patient Similarity Search&#xa;  --&#xa;  - &quot;Find patients with similar symptoms&quot;&#xa;  - Embeddings from: chief_complaint + HPI + diagnoses&#xa;  - Cosine similarity ranks patient cohorts&#xa;  - Powers differential diagnosis support&#xa;  --&#xa;  Privacy: Same RLS as source records.&#xa;  Embeddings are PHI — treat as medical data." id="vznR4AJISN_gQ8VAilp--1661">
          <mxCell parent="vznR4AJISN_gQ8VAilp--1099" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1">
