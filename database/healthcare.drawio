        <UserObject label="  Search Audit Trail&#xa;  --&#xa;  Log every semantic search for audit.&#xa;  query_embedding stored for pattern analysis.&#xa;  Helps identify knowledge gaps in&#xa;  your guideline library over time." plantUmlId="note_565" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" plantUmlBaseValue="  Search Audit Trail&#xa;  --&#xa;  Log every semantic search for audit.&#xa;  query_embedding stored for pattern analysis.&#xa;  Helps identify knowledge gaps in&#xa;  your guideline library over time." id="vznR4AJISN_gQ8VAilp--1663">
