        <UserObject label="  pgvector: Semantic Document Search&#xa;  --&#xa;  Upload MoHCC guidelines, WHO protocols,&#xa;  local SOPs. Chunk + embed with a small&#xa;  local model (all-MiniLM-L6-v2, 384 dims).&#xa;  No API calls, runs entirely on CPU.&#xa;  --&#xa;  SQL:&#xa;  SELECT chunk_text,&#xa;    1 - (chunk_text_embedding &lt;=&gt; query_vec) AS similarity&#xa;  FROM clinical_document_chunks&#xa;  ORDER BY chunk_text_embedding &lt;=&gt; query_vec&#xa;  LIMIT 5;" plantUmlId="note_561" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" plantUmlBaseValue="  pgvector: Semantic Document Search&#xa;  --&#xa;  Upload MoHCC guidelines, WHO protocols,&#xa;  local SOPs. Chunk + embed with a small&#xa;  local model (all-MiniLM-L6-v2, 384 dims).&#xa;  No API calls, runs entirely on CPU.&#xa;  --&#xa;  SQL:&#xa;  SELECT chunk_text,&#xa;    1 - (chunk_text_embedding &lt;=&gt; query_vec) AS similarity&#xa;  FROM clinical_document_chunks&#xa;  ORDER BY chunk_text_embedding &lt;=&gt; query_vec&#xa;  LIMIT 5;" id="vznR4AJISN_gQ8VAilp--1659">
          <mxCell parent="vznR4AJISN_gQ8VAilp--1099" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1">
