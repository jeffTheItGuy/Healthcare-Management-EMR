            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="  Batch &amp; Expiry Tracking&#xa;  - FIFO consumption enforced at dispense&#xa;  - EXPIRED status auto-set via cron&#xa;  - QUARANTINE for damaged/recalled stock&#xa;  - Critical in Zim: supply chain disruptions&#xa;    cause variable expiry dates per batch" plantUmlId="note_555" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" plantUmlBaseValue="  Batch &amp; Expiry Tracking&#xa;  - FIFO consumption enforced at dispense&#xa;  - EXPIRED status auto-set via cron&#xa;  - QUARANTINE for damaged/recalled stock&#xa;  - Critical in Zim: supply chain disruptions&#xa;    cause variable expiry dates per batch" id="vznR4AJISN_gQ8VAilp--1653">
          <mxCell parent="vznR4AJISN_gQ8VAilp--1099" style="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;fontSize=13;fontColor=#000000;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1">
